# Playwright MCP の出力先（.mcp.json の --output-dir で固定）。
# フォルダ自体は追跡し（.gitkeep）、中の生成物は無視する。
.playwright-mcp/*
!.playwright-mcp/.gitkeep
# UI確認用スクショ・スナップショット（ルート直下に出たもの）
/*.png
/*.yml

# DBバックアップ（顧客データ・コミット厳禁）
supabase/backups/

# 巻き直し前の旧マイグレーション（ローカル参照専用・適用済み）
supabase/migrations/_archive/
